active mavuika;
fn mav_dc_cancel ( d_travel_f ) { if d_travel_f < 6 { d_travel_f = 6 ; } let dash_ns = 10 ; let base_cons = 0.9 ; let base_tick_rate = 6 ; while ! .mavuika .dash .ready { print ( "waiting on mavuika dash cd" ) ; wait ( 1 ) ; } let d_ticks = d_travel_f / base_tick_rate + 1 ; print ( "Max number of NS ticks during dash: " , d_ticks ) ; let ns_consumed = dash_ns + base_cons * d_ticks ; print ( "Expected NS consumption: " , ns_consumed ) ; if .mavuika .nightsoul .points > ns_consumed || .mavuika .status .mavuika-burst { mavuika dash [ charge_cancel = 1 , travel = d_travel_f ] , charge ; } else { print ( "current NS points = " , .mavuika .nightsoul .points ) ; print ( "skipping mav d*c, not enough NS points " ) ; mavuika jump ; } }
while 1 {
let optimizer_cycle_start=f();
for let i = 0 ; i < 4 ; i = i + 1 { mavuika skill [ hold = 1 ] ; nicole skill , attack ; xilo skill , attack : 2 ; pick_up_crystallize ( "any" ) ; citlali swap ; if is_even ( i ) { wait ( 15 ) ; citlali attack , skill ; mavuika swap ; if .mavuika .nightsoul .points { mavuika skill [ recast = 1 ] ; mavuika charge ; } mavuika burst ; mavuika charge , charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika charge [ hold = 30 ] , charge [ final = 1 ] ; print ( "after Q buff end" ) ; mav_dc_cancel ( 6 ) ; mavuika charge [ hold = 40 ] , charge [ final = 1 ] ; } else { citlali skill , burst , attack : 2 , dash ; mavuika swap ; if .mavuika .nightsoul .points { mavuika skill [ recast = 1 ] ; delay ( 11 ) ; mavuika charge ; } mavuika burst ; mavuika charge , charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika charge [ hold = 40 ] , charge [ final = 1 ] ; print ( "after Q buff end" ) ; mav_dc_cancel ( 6 ) ; mavuika charge [ hold = 40 ] , charge [ final = 1 ] ; mav_dc_cancel ( 6 ) ; mavuika jump ; } }
if f() == optimizer_cycle_start { wait(1); }
}