# manifest-sha256=6667853408bffb62f59e1916a9a0e5afdf50e2540c9bb60ad6ad60c3f4e408a6
options duration=450 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;
# Build from the source config, used to validate the rotation.

mualani char lvl=90/90 cons=0 talent=10,10,10;
mualani add weapon="surfsup" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=4;
mualani add stats def%=0.124 hp=5646 hp%=0.664 atk=327 atk%=0.193 er=0.052000000000000005 em=316.5 cr=0.268 cd=0.964 hydro%=0.466;

xiangling char lvl=90/90 cons=6 talent=3,8,9;
xiangling add weapon="favoniuslance" refine=5 lvl=90/90;
xiangling add set="emblemofseveredfate" count=2;
xiangling add stats def%=0.336 def=58 hp=5736 hp%=0.057999999999999996 atk=377 atk%=0.513 er=1.613 em=19 cr=0.40800000000000003 cd=0.156;

xilonen char lvl=90/90 cons=0 talent=1,9,8;
xilonen add weapon="peakpatrolsong" refine=1 lvl=90/90;
xilonen add set="scrolloftheheroofcindercity" count=4;
xilonen add stats def%=1.6909999999999998 def=16 hp=6155 hp%=0.09300000000000001 atk=340 atk%=0.11699999999999999 er=1.056 em=49 cr=0.19 cd=0.272;

chiori char lvl=90/90 cons=6 talent=10,10,10;
chiori add weapon="urakumisugiri" refine=1 lvl=90/90;
chiori add set="huskofopulentdreams" count=4;
chiori add stats def%=1.131 def=99 hp=4780 hp%=0.057999999999999996 atk=344 atk%=0.09899999999999999 er=0.057999999999999996 cr=0.669 cd=0.8630000000000001 geo%=0.466;

active chiori;
while 1 {
let pcs=f();


let last_burst = false;
fn mualani_combo() {
  last_burst = false;
  mualani skill;
  for let k = 0; k < 3 && .mualani.nightsoul.state; k = k + 1 {
    if k == 2 && .mualani.burst.ready {
      mualani burst;
      last_burst = true;
      break;
    }
    
    while .mualani.momentum < 3 {
      mualani walk[f=1];
    }
    mualani attack;
  }
  
  if .mualani.nightsoul.state {
    mualani skill;
  }
}
for let i = 0; i < 4; i = i + 1 {
  chiori skill:2;
  mualani attack:3;
  xilonen skill, attack:2;

  for let k = 0; k < 3; k = k + 1 {
    if .xiangling.burst.ready {
      xiangling burst;
      break;
    }
    xiangling attack;
  }
  xiangling skill, dash;
  
  if .chiori.skill.ready { 
    chiori skill:2;
  }
  mualani_combo();
}
if last_burst {
  wait(12);
}

if f() == pcs { wait(1); }
}
